{
  "manifest_version": 3,
  "name": "YouTube Super Comments",
  "short_name": "YT Super Comments",
  "version": "1.6.3",
  "description": "Exibe comentários com timestamps diretamente sobre o player do YouTube no momento exato citado.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "YouTube Super Comments"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://www.youtube.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png", "styles.css"],
      "matches": ["*://www.youtube.com/*"]
    }
  ]
}
